<Window x:Class="ReactionTimeGame.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ReactionTimeGame"
        mc:Ignorable="d"
        Title="Reakcióidő Játék" Height="450" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E2E" Offset="0"/>
                <GradientStop Color="#313244" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Utasítások -->
            <TextBlock x:Name="InstructionText" Text="Nyomd meg az Új Játék gombot!"
                       FontSize="18" TextAlignment="Center"
                       Foreground="#CDD6F4"
                       Margin="10,0,10,30"/>

            <!-- Reakció gomb -->
            <Button x:Name="ReactionButton" Content="KATTINTS MOST!"
                    FontSize="20" Width="220" Height="60"
                    Margin="0,0,0,20"
                    Background="#A6E3A1" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Visibility="Hidden" Click="ReactionButton_Click"/>

            <!-- Új játék gomb -->
            <Button Content="▶  Új játék"
                    Width="200" Height="46" FontSize="15"
                    Margin="0,0,0,12"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Click="StartGame"/>

            <!-- Vissza a menübe gomb -->
            <Button Content="← Vissza a menübe"
                    Width="200" Height="46" FontSize="15"
                    Background="#45475A" Foreground="#CDD6F4"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Click="BackToMenu_Click"/>
        </StackPanel>
    </Grid>
</Window>
