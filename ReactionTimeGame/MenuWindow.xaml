<Window x:Class="ReactionTimeGame.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Reakcióidő Játék" Height="420" Width="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E2E" Offset="0"/>
                <GradientStop Color="#313244" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="⏱ Reakcióidő Játék"
                       FontSize="30" FontWeight="Bold"
                       Foreground="#CDD6F4"
                       TextAlignment="Center"
                       Margin="0,0,0,10"/>
            <TextBlock Text="Teszteld a reakcióidődet!"
                       FontSize="14"
                       Foreground="#A6ADC8"
                       TextAlignment="Center"
                       Margin="0,0,0,40"/>

            <Button Content="▶  Játék Indítása"
                    Width="220" Height="50" FontSize="16"
                    Margin="0,0,0,12"
                    Background="#A6E3A1" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Click="StartGame_Click"/>

            <Button Content="🏆  Eredménylista"
                    Width="220" Height="50" FontSize="16"
                    Margin="0,0,0,12"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Click="Scoreboard_Click"/>

            <Button Content="✖  Kilépés"
                    Width="220" Height="50" FontSize="16"
                    Margin="0,0,0,0"
                    Background="#F38BA8" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Click="Exit_Click"/>
        </StackPanel>
    </Grid>
</Window>
