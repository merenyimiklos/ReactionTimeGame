<Window x:Class="ReactionTimeGame.ScoreBoardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Eredménylista" Height="500" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid>
        <Grid.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#1E1E2E" Offset="0"/>
                <GradientStop Color="#313244" Offset="1"/>
            </LinearGradientBrush>
        </Grid.Background>

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Fejléc -->
        <TextBlock Grid.Row="0"
                   Text="🏆 Eredménylista"
                   FontSize="26" FontWeight="Bold"
                   Foreground="#CDD6F4"
                   TextAlignment="Center"
                   Margin="0,20,0,16"/>

        <!-- Eredmény táblázat -->
        <DataGrid x:Name="ScoreGrid"
                  Grid.Row="1"
                  Margin="20,0,20,0"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserSortColumns="False"
                  CanUserResizeRows="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  RowBackground="#2A2A3E"
                  AlternatingRowBackground="#313244"
                  Background="#2A2A3E"
                  Foreground="#CDD6F4"
                  BorderBrush="#45475A"
                  HorizontalScrollBarVisibility="Disabled"
                  SelectionMode="Single">
            <DataGrid.ColumnHeaderStyle>
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="#45475A"/>
                    <Setter Property="Foreground" Value="#CDD6F4"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="Padding" Value="8,6"/>
                    <Setter Property="BorderThickness" Value="0"/>
                </Style>
            </DataGrid.ColumnHeaderStyle>
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell">
                    <Setter Property="BorderThickness" Value="0"/>
                    <Setter Property="Padding" Value="8,4"/>
                </Style>
            </DataGrid.CellStyle>
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="40"/>
                <DataGridTextColumn Header="Reakcióidő" Binding="{Binding ReactionTimeDisplay}" Width="130"/>
                <DataGridTextColumn Header="Dátum" Binding="{Binding DateDisplay}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Üzenet ha nincs eredmény -->
        <TextBlock x:Name="EmptyMessage"
                   Grid.Row="1"
                   Text="Még nincs egyetlen eredmény sem.&#10;Játssz egy kört, és nézd meg, milyen gyors vagy!"
                   FontSize="14"
                   Foreground="#A6ADC8"
                   TextAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="Collapsed"/>

        <!-- Gombok -->
        <StackPanel Grid.Row="2" Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,16,0,20">
            <Button Content="🗑  Törlés"
                    Width="130" Height="40" FontSize="14"
                    Margin="0,0,12,0"
                    Background="#F38BA8" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Click="ClearScores_Click"/>
            <Button Content="← Vissza"
                    Width="130" Height="40" FontSize="14"
                    Background="#89B4FA" Foreground="#1E1E2E"
                    FontWeight="Bold" BorderThickness="0"
                    Cursor="Hand"
                    Click="Back_Click"/>
        </StackPanel>
    </Grid>
</Window>
